# ==============================================================================
# HEY JEV CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure values as needed.
# NEVER commit your actual .env file or API keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Model & Decision API Keys
# ------------------------------------------------------------------------------
# TypeSafe API key for speculative Jev decision battery (Tier 1 voice reflex)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Fish Audio API key for cloud neural voice synthesis (TTS)
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# OpenRouter API key for general Q&A chit-chat responses (Haiku / Claude)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenCode Zen API key for coding and developer tasks
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
# Alternative alias: OPENCODE_API_KEY=your_opencode_api_key_here

# Optional: OpenAI API key for GPT-4o-mini answers or dictation fallback
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Voice & Speech Recognition Settings
# ------------------------------------------------------------------------------
# STT engine: 'whisper' (default)
HEYJEV_STT=whisper

# Whisper model name. The shipped default is 'small.en' -- the value in
# config.WHISPER_MODEL and stt.py. Earlier docs advertised 'tiny.en' here while
# the code ran small.en, so the documented system never existed (B5).
# Options: 'tiny.en' (fastest, least accurate), 'base.en', 'small.en' (default)
HEYJEV_WHISPER_MODEL=small.en

# Optional custom initial prompt and hotwords to bias speech recognition
HEYJEV_STT_PROMPT="Hey Jev, open Spotify, VS Code, Slack, Chrome, Notepad, Calculator"
HEYJEV_STT_HOTWORDS="Spotify,Chrome,Calculator,Notepad,Edge"

# Wake-word engine: 'whisper' (VAD gated, default) or 'openwakeword'.
# This was 'openwakeword' here while config.DEFAULT_WAKEWORD_ENGINE defaulted
# to 'whisper', so copying this file silently changed the wake engine (B6).
HEYJEV_WAKEWORD_ENGINE=whisper

# TTS provider: 'fish_audio' (cloud default) or 'kokoro' (local ONNX)
HEYJEV_TTS_PROVIDER=fish_audio

# Audio muting for headless/automated test runs: 0 (unmuted) or 1 (muted)
HEYJEV_MUTE=0

# Disable pre-warming TTS cache on startup: 0 (enabled) or 1 (disabled)
HEYJEV_DISABLE_WARM_CACHE=0

# ------------------------------------------------------------------------------
# 3. Decision Backend & Tier 3 Agent
# ------------------------------------------------------------------------------
# Decision backend: 'jev' (remote TypeSafe API) or 'laya' (local ONNX)
HEYJEV_BACKEND=jev

# Optional local Laya ONNX checkpoint path (if HEYJEV_BACKEND=laya)
LAYA_CHECKPOINT=

# Answer provider: 'openrouter' (default), 'opencode_zen', or 'none'
HEYJEV_ANSWER_PROVIDER=openrouter

# Enable Tier 3 tool-calling autonomous agent: 'true' or 'false'
HEYJEV_TIER3_ENABLED=false

# Tier 3 daily spend budget cap in USD (default: 5.00)
HEYJEV_TIER3_DAILY_SPEND_CAP=5.00

# ------------------------------------------------------------------------------
# 4. OpenDots Model Context Protocol (MCP) Gateway
# ------------------------------------------------------------------------------
# Enable the MCP Streamable HTTP gateway server: 'true' or 'false'
JEV_ENABLE_OPENDOTS_GATEWAY=true

# Loopback host to bind (MUST be 127.0.0.1 for local security)
JEV_OPENDOTS_HOST=127.0.0.1

# HTTP port for the MCP gateway (default: 8765)
JEV_OPENDOTS_PORT=8765

# Bearer token for MCP client authentication (generate a strong random string)
JEV_OPENDOTS_BEARER_TOKEN=change_me_to_a_secure_random_token

# Maximum concurrent connections allowed by the gateway
JEV_OPENDOTS_MAX_CONCURRENCY=8

# ------------------------------------------------------------------------------
# 5. External Tool Integrations
# ------------------------------------------------------------------------------
# Optional path to external Windows MCP automation executable (if available)
HEYJEV_WINDOWS_MCP_EXE=
